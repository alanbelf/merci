---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, tourismServices, expatServices, testimonials } from '../data/site';
import heroImage from '../assets/hero-qatar-lifestyle.jpg';
import desertImage from '../assets/desert-experience.jpg';
import hospitalityImage from '../assets/arabian-hospitality.jpg';
import homeImage from '../assets/finding-a-home.jpg';
import dohaImage from '../assets/discover-doha.jpg';
import coastalImage from '../assets/coastal-luxury.jpg';
import logoImage from '../assets/merci-concierge-logo.jpeg';
import nassimPortrait from '../assets/nassim-portrait.jpg';
---
<BaseLayout title="Merci Concierge | Your private access to Doha’s luxury lifestyle" description={site.intro}>
  <header class="topbar">
    <a class="header-logo-link" href="#top" aria-label="Merci Concierge home">
      <img class="header-logo" src={logoImage.src} alt="Merci Concierge — Doha · Paris" />
    </a>
    <nav aria-label="Main navigation">
      <a href="#about">About</a>
      <a href="#services">Services</a>
      <a href="#relocation">Relocation</a>
      <div class="theme-switcher" role="group" aria-label="Choose colour theme">
        <button type="button" data-set-theme="ivory" aria-pressed="false" aria-label="Use light theme">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" /></svg>
        </button>
        <button type="button" data-set-theme="midnight" aria-pressed="false" aria-label="Use dark theme">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.2 15.4A8.5 8.5 0 0 1 8.6 3.8 8.5 8.5 0 1 0 20.2 15.4Z" /></svg>
        </button>
      </div>
      <a class="nav-cta" href={site.whatsappUrl} target="_blank" rel="noopener noreferrer">Get in touch</a>
    </nav>
  </header>

  <main id="top">
    <section class="hero">
      <div class="hero-image" role="img" aria-label="Qatar landscape">
        <img src={heroImage.src} alt="Doha skyline and a private yacht on the waterfront at blue hour" fetchpriority="high" />
      </div>
      <div class="hero-shade"></div>
      <div class="hero-content">
        <p class="eyebrow">YOUR PERSONAL CONCIERGE IN QATAR</p>
        <h1>Your private access,<br /><em>to Doha’s luxury lifestyle</em></h1>
        <p class="hero-copy">{site.intro}</p>
        <a class="button button-light" href={site.whatsappUrl} target="_blank" rel="noopener noreferrer">Let's make it happen <span>↗</span></a>
      </div>
      <div class="hero-note">DOHA · QATAR</div>
    </section>

    <section class="pillars section">
      <div class="pillars-heading" data-reveal>
        <div class="section-label">TWO WAYS WE CAN HELP</div>
        <p class="eyebrow">ONE PERSONAL CONCIERGE</p>
        <h2>Made for your<br /><em>Qatar chapter.</em></h2>
      </div>
      <div class="pillar-grid">
        <article class="pillar-card" data-reveal data-reveal-delay="0">
          <span class="service-number">01 / FOR VISITORS</span>
          <h3>High-End Tourism</h3>
          <p class="pillar-subtitle">The Qatar Experience</p>
          <p>Discover Qatar with thoughtful itineraries, local recommendations and personal assistance shaped around your interests.</p>
          <a class="text-link" href="#services">Explore visitor services <span>↗</span></a>
        </article>
        <article class="pillar-card" data-reveal data-reveal-delay="1">
          <span class="service-number">02 / FOR NEW ARRIVALS</span>
          <h3>Premium Expatriation</h3>
          <p class="pillar-subtitle">The Soft Landing</p>
          <p>Settle into life in Qatar with practical guidance, local insight and a friendly point of contact as you find your feet.</p>
          <a class="text-link" href="#relocation">Explore relocation support <span>↗</span></a>
        </article>
      </div>
    </section>

    <section class="about section" id="about">
      <div class="about-intro">
        <div class="about-heading" data-reveal>
          <div class="section-label">MEET NASSIM</div>
          <p class="eyebrow">THE PERSON BEHIND MERCI CONCIERGE</p>
          <h2>I’m Nassim.</h2>
          <p class="lead">A local connection. A personal commitment.</p>
        </div>
        <figure class="about-portrait" data-reveal>
          <img src={nassimPortrait.src} alt="Nassim, founder of Merci Concierge" width="200" height="200" loading="lazy" decoding="async" />
        </figure>
      </div>
      <div class="about-story" data-reveal>
        <p>I’m a French expat and family man who chose to make Qatar home. After travelling around the world, I fell in love with its sunshine, family-friendly atmosphere, and relaxed way of life. It felt like the right place to settle with my family.</p>
        <p>Over the years, I’ve built relationships here and learned how to navigate the everyday details that can feel unfamiliar when you arrive. Finding a home, arranging a car, planning a desert escape, or bringing people together for an event: knowing where to turn can make all the difference.</p>
        <p>Merci Concierge brings that experience and local network together with a personal approach. I start by listening to what you need, what matters to you, and what budget you’re comfortable with. From there, I look for options that genuinely fit, rather than asking you to fit into a ready-made package.</p>
        <p><strong>Your interests come first.</strong> No relationship with a supplier takes priority over your needs. I believe in honest recommendations, clear communication, and fees that are explained and agreed upfront, with no hidden charges.</p>
        <p>Away from work, I enjoy football, good food, and spending time with my family. That’s part of what I appreciate about life here, and what I hope to help you enjoy too, whether you’re visiting Qatar or making it your home.</p>
        <div class="about-signature">
          <span>Nassim</span>
          <span>Founder, Merci Concierge</span>
        </div>
      </div>
      <div class="about-commitments">
        <article data-reveal data-reveal-delay="0">
          <h3>Personal recommendations</h3>
          <p>Shaped around your needs, preferences, and budget.</p>
        </article>
        <article data-reveal data-reveal-delay="1">
          <h3>Your interests first</h3>
          <p>Your needs take priority over supplier relationships.</p>
        </article>
        <article data-reveal data-reveal-delay="2">
          <h3>Clear fees upfront</h3>
          <p>Explained and agreed before you commit.</p>
        </article>
      </div>
      <a class="button button-dark about-cta" href={site.whatsappUrl} target="_blank" rel="noopener noreferrer">Tell me what you have in mind <span>↗</span></a>
    </section>

    <section class="services section" id="services">
      <div class="section-heading">
        <div data-reveal>
          <div class="section-label">EXPLORE WITH CONFIDENCE</div>
          <p class="eyebrow">FOR VISITORS & CURIOUS MINDS</p>
          <h2>Discover Qatar<br /><em>your way.</em></h2>
        </div>
        <p class="section-aside" data-reveal>From the first idea to the little details, enjoy a more personal way to experience the country.</p>
      </div>
      <div class="service-grid">
        {tourismServices.map((service, i) => (
          <article class="service-card" data-reveal data-reveal-delay={Math.min(i, 3)}>
            <span class="service-number">0{i + 1}</span>
            <h3>{service.title}</h3>
            <p>{service.description}</p>
            <a href="#contact" aria-label={`Ask about ${service.title}`}>↗</a>
          </article>
        ))}
      </div>
      <div class="experience-gallery">
        <div class="experience-gallery-heading" data-reveal>
          <p class="eyebrow">A CLOSER LOOK AT QATAR</p>
          <h3>Places and moments<br /><em>to remember.</em></h3>
        </div>
        <div class="experience-gallery-grid">
          <figure data-reveal data-reveal-delay="0">
            <img src={desertImage.src} alt="Golden dunes meet the Inland Sea at sunset, with a 4x4 on the ridge" loading="lazy" />
            <figcaption>The Inland Sea</figcaption>
          </figure>
          <figure data-reveal data-reveal-delay="1">
            <img src={hospitalityImage.src} alt="A warmly lit desert majlis at dusk, arranged with cushions and a traditional coffee service" loading="lazy" />
            <figcaption>A desert welcome</figcaption>
          </figure>
          <figure data-reveal data-reveal-delay="2">
            <img src={coastalImage.src} alt="A yacht deck overlooking Doha's illuminated skyline at twilight" loading="lazy" />
            <figcaption>Doha by water</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="image-band" data-reveal>
      <img src={dohaImage.src} alt="Traditional Souq Waqif architecture and lanterns at early evening, with Doha's skyline beyond" loading="lazy" />
      <div class="image-caption">Souq Waqif, as evening settles.</div>
    </section>

    <section class="relocation section" id="relocation">
      <div class="relocation-visual" data-reveal>
        <img src={homeImage.src} alt="A warm, contemporary Doha apartment overlooking the city at sunset" loading="lazy" />
        <div class="visual-caption">FEEL AT HOME, FASTER.</div>
      </div>
      <div class="relocation-copy" data-reveal>
        <div class="section-label">A NEW CHAPTER</div>
        <p class="eyebrow">FOR THOSE MAKING QATAR HOME</p>
        <h2>New beginnings<br /><em>feel better supported.</em></h2>
        <p>Moving to a new country comes with a thousand little questions. Get practical local guidance and a friendly helping hand as you find your feet in Qatar.</p>
        <div class="simple-list">
          {expatServices.map((service) => (
            <div class="simple-item">
              <div><h3>{service.title}</h3><p>{service.description}</p></div>
              <span>↗</span>
            </div>
          ))}
        </div>
        <a class="text-link" href="#contact">Tell us what you need <span>↗</span></a>
      </div>
    </section>

    <section class="promise section">
      <div class="section-label" data-reveal>THE MERCI DIFFERENCE</div>
      <div data-reveal>
        <p class="eyebrow">PERSONAL BY NATURE</p>
        <h2>Thoughtful details.<br /><em>Human connection.</em></h2>
        <div class="promise-grid">
          <div data-reveal data-reveal-delay="0"><span>01</span><h3>Personal attention</h3><p>No one-size-fits-all approach. Your needs come first.</p></div>
          <div data-reveal data-reveal-delay="1"><span>02</span><h3>Local perspective</h3><p>Useful insight to help you make informed choices.</p></div>
          <div data-reveal data-reveal-delay="2"><span>03</span><h3>Care in the details</h3><p>Considered support from the first conversation onwards.</p></div>
        </div>
      </div>
    </section>

    <section class="testimonials section">
      <div class="section-label" data-reveal>KIND WORDS</div>
      <div class="testimonial-content" data-reveal>
        <p class="eyebrow">THE EXPERIENCE MATTERS</p>
        <h2>A few words<br /><em>from our clients.</em></h2>
      </div>
      <div class="testimonial-summary" aria-label="5.0 on Google, 15 plus reviews">
        <span class="summary-stars" aria-hidden="true">★★★★★</span>
        <p><strong>5.0 on Google</strong><span aria-hidden="true"> · </span><span>15+ reviews</span></p>
      </div>
      <div class="quotes" role="region" aria-label="Client testimonials" tabindex="0">
        <div class="review-track">
          <div class="review-set">
            {testimonials.map((item, index) => (
              <blockquote id={`client-review-${index + 1}`} class="review-card">
                <span class="quote-mark" aria-hidden="true">“</span>
                <p>{item.quote}</p>
                <cite>
                  {item.url ? (
                    <a href={item.url} target="_blank" rel="noopener noreferrer">{item.author}</a>
                  ) : item.author}
                </cite>
                <svg class="review-icon" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                  {index === 0 || index === 4 ? (
                    <>
                      <circle cx="35" cy="12" r="4" />
                      <path d="M5 34c7-8 12-8 19 0s12 8 19 0M5 40c7-8 12-8 19 0s12 8 19 0" />
                    </>
                  ) : index === 1 || index === 5 || index === 7 ? (
                    <>
                      <path d="M7 39h34M11 39V20h26v19M17 20v-6h14v6M20 39V27h8v12" />
                      <path d="M18 14V9h12v5" />
                    </>
                  ) : index === 2 || index === 8 ? (
                    <>
                      <path d="M8 24 24 11l16 13M12 22v17h24V22M20 39V28h8v11" />
                      <path d="M24 7v4" />
                    </>
                  ) : (
                    <>
                      <circle cx="24" cy="24" r="16" />
                      <path d="m18 30 4-10 10-4-4 10-10 4ZM24 24l4-4" />
                    </>
                  )}
                </svg>
              </blockquote>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="why-us section">
      <div class="why-us-heading" data-reveal>
        <div class="section-label">WHY MERCI</div>
        <p class="eyebrow">LOCAL KNOWLEDGE, PERSONAL CARE</p>
        <h2>Qatar,<br /><em>made personal.</em></h2>
      </div>
      <div class="why-us-grid">
        <article data-reveal data-reveal-delay="0">
          <span>01</span>
          <h3>Deep local knowledge</h3>
          <p>Practical insight into Qatar to help you make informed choices, whether you are visiting or settling in.</p>
        </article>
        <article data-reveal data-reveal-delay="1">
          <span>02</span>
          <h3>Discreet & personal</h3>
          <p>Thoughtful, one-to-one assistance shaped around your needs, with care for the details and WhatsApp concierge availability, 24/7.</p>
        </article>
        <article data-reveal data-reveal-delay="2">
          <span>03</span>
          <h3>French & English</h3>
          <p>Native French and English support, with a francophone perspective and clear communication.</p>
        </article>
        <article class="rating-card" data-reveal data-reveal-delay="3">
          <span class="rating-stars" aria-label="5 out of 5 stars">★★★★★</span>
          <h3>5 stars on Google</h3>
          <p>Rated 5 stars across 18 Google reviews.</p>
        </article>
      </div>
    </section>

    <section class="how-it-works section">
      <div class="how-heading" data-reveal>
        <div class="section-label">HOW IT WORKS</div>
        <p class="eyebrow">A SIMPLE FIRST STEP</p>
        <h2>Explore the possibilities,<br /><em>at your own pace.</em></h2>
        <p class="how-intro">Start with a conversation. There is no upfront cost or commitment to proceed.</p>
      </div>
      <ol class="steps-grid">
        <li data-reveal data-reveal-delay="0">
          <span>01</span>
          <h3>Say hello</h3>
          <p>Send us a WhatsApp message with a little about what you have in mind.</p>
        </li>
        <li data-reveal data-reveal-delay="1">
          <span>02</span>
          <h3>Talk it through</h3>
          <p>We’ll learn what matters to you, your timing and any questions you have.</p>
        </li>
        <li data-reveal data-reveal-delay="2">
          <span>03</span>
          <h3>Receive a tailored proposal</h3>
          <p>We’ll share suitable options and clear pricing, shaped around your needs.</p>
        </li>
        <li data-reveal data-reveal-delay="3">
          <span>04</span>
          <h3>Choose what feels right</h3>
          <p>Review your options, ask questions, and decide if you’d like to proceed.</p>
        </li>
      </ol>
      <a class="button button-dark" href={site.whatsappUrl} target="_blank" rel="noopener noreferrer">Start a WhatsApp conversation <span>↗</span></a>
    </section>

    <section class="contact" id="contact">
      <div class="contact-inner" data-reveal>
        <p class="eyebrow">LET'S START WITH A CONVERSATION</p>
        <h2>How can we make<br /><em>life easier?</em></h2>
        <p>Tell us a little about what you have in mind. We'll take it from there.</p>
        <a class="button button-light" href={site.whatsappUrl} target="_blank" rel="noopener noreferrer">Message us on WhatsApp <span>↗</span></a>
        <div class="contact-details">
          <div><span>WHATSAPP</span><a href={site.whatsappUrl} target="_blank" rel="noopener noreferrer">{site.phone}</a></div>
          <div><span>CALL</span><a href={site.phoneLink}>{site.phone}</a></div>
          <div><span>BASED IN</span><p>{site.location}</p></div>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <a class="footer-logo-link" href="#top" aria-label="Merci Concierge home">
      <img class="footer-logo" src={logoImage.src} alt="Merci Concierge — Doha · Paris" loading="lazy" />
    </a>
    <p>Thoughtful concierge services in Qatar.</p>
    <div class="footer-social">
      <p>Follow along</p>
      <div class="footer-social-links">
        <a href="https://www.instagram.com/merciconcierge/?hl=en" target="_blank" rel="noopener noreferrer" aria-label="Merci Concierge on Instagram">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <rect x="3" y="3" width="18" height="18" rx="5" />
            <circle cx="12" cy="12" r="4" />
            <circle cx="17.5" cy="6.5" r=".75" fill="currentColor" stroke="none" />
          </svg>
          <span>Instagram</span>
        </a>
        <a href="https://www.tiktok.com/@merciconcierge" target="_blank" rel="noopener noreferrer" aria-label="Merci Concierge on TikTok">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
            <path d="M19.6 7.3a6.6 6.6 0 0 1-4-1.3v8.2a5.8 5.8 0 1 1-5-5.7v3.2a2.6 2.6 0 1 0 1.8 2.5V2.5h3.2c.2 2 1.7 3.6 4 3.8v3.2Z" />
          </svg>
          <span>TikTok</span>
        </a>
      </div>
    </div>
    <p>© {new Date().getFullYear()} Merci Concierge</p>
  </footer>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, tourismServices, expatServices, testimonials } from '../data/site';
import heroImage from '../assets/hero-qatar-lifestyle.jpg';
import desertImage from '../assets/desert-experience.jpg';
import hospitalityImage from '../assets/arabian-hospitality.jpg';
import homeImage from '../assets/finding-a-home.jpg';
import dohaImage from '../assets/discover-doha.jpg';
import coastalImage from '../assets/coastal-luxury.jpg';
import logoImage from '../assets/merci-concierge-logo.jpeg';
---
<BaseLayout title="Merci Concierge | Your life in Qatar, made effortless" description={site.intro}>
  <header class="topbar">
    <a class="header-logo-link" href="#top" aria-label="Merci Concierge home">
      <img class="header-logo" src={logoImage.src} alt="Merci Concierge — Doha · Paris" />
    </a>
    <nav aria-label="Main navigation">
      <a href="#about">About</a>
      <a href="#services">Services</a>
      <a href="#relocation">Relocation</a>
      <div class="theme-switcher" role="group" aria-label="Choose colour theme">
        <button type="button" data-set-theme="ivory" aria-pressed="true" aria-label="Use Warm Ivory theme" title="Warm Ivory">☼ <span>Warm Ivory</span></button>
        <button type="button" data-set-theme="midnight" aria-pressed="false" aria-label="Use Midnight Doha theme" title="Midnight Doha">☾ <span>Midnight Doha</span></button>
      </div>
      <a class="nav-cta" href={site.whatsappUrl} target="_blank" rel="noopener noreferrer">Get in touch</a>
    </nav>
  </header>

  <main id="top">
    <section class="hero">
      <div class="hero-image" role="img" aria-label="Qatar landscape">
        <img src={heroImage.src} alt="Doha skyline and a private yacht on the waterfront at blue hour" fetchpriority="high" />
      </div>
      <div class="hero-shade"></div>
      <div class="hero-content">
        <p class="eyebrow">YOUR PERSONAL CONCIERGE IN QATAR</p>
        <h1>Your life in Qatar,<br /><em>made effortless.</em></h1>
        <p class="hero-copy">{site.intro}</p>
        <a class="button button-light" href={site.whatsappUrl} target="_blank" rel="noopener noreferrer">Let's make it happen <span>↗</span></a>
      </div>
      <div class="hero-note">DOHA · QATAR</div>
    </section>

    <section class="intro section" id="about">
      <div class="section-label" data-reveal>01 / A PERSONAL APPROACH</div>
      <div data-reveal>
        <p class="eyebrow">MORE THAN A SERVICE</p>
        <h2>A little local knowledge.<br /><em>A lot more peace of mind.</em></h2>
        <p class="lead">Whether you're visiting Qatar or building a new life here, the right support makes all the difference.</p>
        <p>Merci Concierge offers personal assistance, thoughtful recommendations and local guidance. Every request starts with a conversation, so the support you receive reflects what you actually need.</p>
      </div>
    </section>

    <section class="services section" id="services">
      <div class="section-heading">
        <div data-reveal>
          <div class="section-label">02 / EXPLORE WITH CONFIDENCE</div>
          <p class="eyebrow">FOR VISITORS & CURIOUS MINDS</p>
          <h2>Discover Qatar<br /><em>your way.</em></h2>
        </div>
        <p class="section-aside" data-reveal>From the first idea to the little details, enjoy a more personal way to experience the country.</p>
      </div>
      <div class="service-grid">
        {tourismServices.map((service, i) => (
          <article class="service-card" data-reveal data-reveal-delay={Math.min(i, 3)}>
            <span class="service-number">0{i + 1}</span>
            <h3>{service.title}</h3>
            <p>{service.description}</p>
            <a href="#contact" aria-label={`Ask about ${service.title}`}>↗</a>
          </article>
        ))}
      </div>
      <div class="experience-gallery">
        <div class="experience-gallery-heading" data-reveal>
          <p class="eyebrow">A CLOSER LOOK AT QATAR</p>
          <h3>Places and moments<br /><em>to remember.</em></h3>
        </div>
        <div class="experience-gallery-grid">
          <figure data-reveal data-reveal-delay="0">
            <img src={desertImage.src} alt="Golden dunes meet the Inland Sea at sunset, with a 4x4 on the ridge" loading="lazy" />
            <figcaption>The Inland Sea</figcaption>
          </figure>
          <figure data-reveal data-reveal-delay="1">
            <img src={hospitalityImage.src} alt="A warmly lit desert majlis at dusk, arranged with cushions and a traditional coffee service" loading="lazy" />
            <figcaption>A desert welcome</figcaption>
          </figure>
          <figure data-reveal data-reveal-delay="2">
            <img src={coastalImage.src} alt="A yacht deck overlooking Doha's illuminated skyline at twilight" loading="lazy" />
            <figcaption>Doha by water</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="image-band" data-reveal>
      <img src={dohaImage.src} alt="Traditional Souq Waqif architecture and lanterns at early evening, with Doha's skyline beyond" loading="lazy" />
      <div class="image-caption">Souq Waqif, as evening settles.</div>
    </section>

    <section class="relocation section" id="relocation">
      <div class="relocation-visual" data-reveal>
        <img src={homeImage.src} alt="A warm, contemporary Doha apartment overlooking the city at sunset" loading="lazy" />
        <div class="visual-caption">FEEL AT HOME, FASTER.</div>
      </div>
      <div class="relocation-copy" data-reveal>
        <div class="section-label">03 / A NEW CHAPTER</div>
        <p class="eyebrow">FOR THOSE MAKING QATAR HOME</p>
        <h2>New beginnings<br /><em>feel better supported.</em></h2>
        <p>Moving to a new country comes with a thousand little questions. Get practical local guidance and a friendly helping hand as you find your feet in Qatar.</p>
        <div class="simple-list">
          {expatServices.map((service) => (
            <div class="simple-item">
              <div><h3>{service.title}</h3><p>{service.description}</p></div>
              <span>↗</span>
            </div>
          ))}
        </div>
        <a class="text-link" href="#contact">Tell us what you need <span>↗</span></a>
      </div>
    </section>

    <section class="promise section">
      <div class="section-label" data-reveal>04 / THE MERCI DIFFERENCE</div>
      <div data-reveal>
        <p class="eyebrow">PERSONAL BY NATURE</p>
        <h2>Thoughtful details.<br /><em>Human connection.</em></h2>
        <div class="promise-grid">
          <div data-reveal data-reveal-delay="0"><span>01</span><h3>Personal attention</h3><p>No one-size-fits-all approach. Your needs come first.</p></div>
          <div data-reveal data-reveal-delay="1"><span>02</span><h3>Local perspective</h3><p>Useful insight to help you make informed choices.</p></div>
          <div data-reveal data-reveal-delay="2"><span>03</span><h3>Care in the details</h3><p>Considered support from the first conversation onwards.</p></div>
        </div>
      </div>
    </section>

    <section class="testimonials section">
      <div class="section-label" data-reveal>05 / KIND WORDS</div>
      <div class="testimonial-content" data-reveal>
        <p class="eyebrow">THE EXPERIENCE MATTERS</p>
        <h2>A few words<br /><em>from our clients.</em></h2>
        {testimonials.length > 0 ? (
          <div class="quotes">
            {testimonials.map((item) => (
              <blockquote>
                <span class="quote-mark">“</span>
                <p>{item.quote}</p>
                <cite>{item.author}</cite>
                {item.url && <a class="review-link" href={item.url} target="_blank" rel="noopener noreferrer">View original review ↗</a>}
              </blockquote>
            ))}
          </div>
        ) : (
          <p class="small-note">Client reviews will be shared here once the original review text is available.</p>
        )}
      </div>
    </section>

    <section class="contact" id="contact">
      <div class="contact-inner" data-reveal>
        <p class="eyebrow">LET'S START WITH A CONVERSATION</p>
        <h2>How can we make<br /><em>life easier?</em></h2>
        <p>Tell us a little about what you have in mind. We'll take it from there.</p>
        <a class="button button-light" href={site.whatsappUrl} target="_blank" rel="noopener noreferrer">Message us on WhatsApp <span>↗</span></a>
        <div class="contact-details">
          <div><span>WHATSAPP</span><a href={site.whatsappUrl} target="_blank" rel="noopener noreferrer">{site.phone}</a></div>
          <div><span>CALL</span><a href={site.phoneLink}>{site.phone}</a></div>
          <div><span>BASED IN</span><p>{site.location}</p></div>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <a class="footer-logo-link" href="#top" aria-label="Merci Concierge home">
      <img class="footer-logo" src={logoImage.src} alt="Merci Concierge — Doha · Paris" loading="lazy" />
    </a>
    <p>Thoughtful concierge services in Qatar.</p>
    <p>© {new Date().getFullYear()} Merci Concierge</p>
  </footer>
</BaseLayout>

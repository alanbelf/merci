---
import '../styles/global.css';
import { site } from '../data/site';
import favicon from '../assets/merci-concierge-favicon.png';
const { title = 'Merci Concierge | Qatar', description = 'Personal concierge services in Qatar.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#172323" />
    <link rel="icon" type="image/png" href={favicon.src} />
    <script is:inline>
      const getSystemTheme = () => {
        try {
          return window.matchMedia('(prefers-color-scheme: light)').matches ? 'ivory' : 'midnight';
        } catch {
          return 'midnight';
        }
      };
      let initialTheme = getSystemTheme();
      try {
        const savedTheme = localStorage.getItem('merci-theme');
        if (savedTheme === 'ivory' || savedTheme === 'midnight') initialTheme = savedTheme;
      } catch {}
      document.documentElement.dataset.theme = initialTheme;
    </script>
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <slot />
    <div class="mobile-contact-bar" aria-label="Contact Merci Concierge">
      <a href={site.whatsappUrl} target="_blank" rel="noopener noreferrer" aria-label="Message Merci Concierge on WhatsApp">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 3.5A11.8 11.8 0 0 0 12.1 0C5.6 0 .3 5.3.3 11.8c0 2.1.6 4.1 1.6 5.9L0 24l6.5-1.7a11.8 11.8 0 0 0 5.6 1.4h.1c6.5 0 11.8-5.3 11.8-11.8 0-3.2-1.2-6.1-3.5-8.4ZM12.1 21.7c-1.7 0-3.4-.5-4.8-1.3l-.3-.2-3.9 1 1-3.8-.2-.3a9.8 9.8 0 1 1 8.2 4.6Zm5.4-7.3c-.3-.2-1.7-.9-2-1s-.5-.2-.7.2-.8 1-1 1.2-.4.2-.7.1a8 8 0 0 1-2.4-1.5 9 9 0 0 1-1.7-2.1c-.2-.3 0-.5.1-.7l.5-.6.3-.5c.1-.2 0-.4 0-.6l-.9-2.1c-.2-.5-.5-.4-.7-.4h-.6c-.2 0-.6.1-.9.4s-1.2 1.2-1.2 2.8 1.2 3.2 1.4 3.4c.2.2 2.4 3.7 5.8 5 .8.3 1.4.5 1.9.6.8.2 1.5.2 2 .1.6-.1 1.7-.7 2-1.4.2-.7.2-1.3.2-1.4s-.2-.3-.5-.4Z"/></svg>
        <span>WhatsApp</span>
      </a>
      <a href={site.phoneLink} aria-label="Call Merci Concierge">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8a15.5 15.5 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.2c1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6a1 1 0 0 1-.2 1l-2.3 2.2Z"/></svg>
        <span>Call</span>
      </a>
    </div>
    <a class="whatsapp-float" href={site.whatsappUrl} target="_blank" rel="noopener noreferrer" aria-label="Message Merci Concierge on WhatsApp">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 3.5A11.8 11.8 0 0 0 12.1 0C5.6 0 .3 5.3.3 11.8c0 2.1.6 4.1 1.6 5.9L0 24l6.5-1.7a11.8 11.8 0 0 0 5.6 1.4h.1c6.5 0 11.8-5.3 11.8-11.8 0-3.2-1.2-6.1-3.5-8.4ZM12.1 21.7c-1.7 0-3.4-.5-4.8-1.3l-.3-.2-3.9 1 1-3.8-.2-.3a9.8 9.8 0 1 1 8.2 4.6Zm5.4-7.3c-.3-.2-1.7-.9-2-1s-.5-.2-.7.2-.8 1-1 1.2-.4.2-.7.1a8 8 0 0 1-2.4-1.5 9 9 0 0 1-1.7-2.1c-.2-.3 0-.5.1-.7l.5-.6.3-.5c.1-.2 0-.4 0-.6l-.9-2.1c-.2-.5-.5-.4-.7-.4h-.6c-.2 0-.6.1-.9.4s-1.2 1.2-1.2 2.8 1.2 3.2 1.4 3.4c.2.2 2.4 3.7 5.8 5 .8.3 1.4.5 1.9.6.8.2 1.5.2 2 .1.6-.1 1.7-.7 2-1.4.2-.7.2-1.3.2-1.4s-.2-.3-.5-.4Z"/></svg>
    </a>
    <script is:inline>
      const themeButtons = document.querySelectorAll('[data-set-theme]');
      const setTheme = (theme, save = true) => {
        document.documentElement.dataset.theme = theme;
        themeButtons.forEach((button) => {
          const selected = button.dataset.setTheme === theme;
          button.setAttribute('aria-pressed', String(selected));
        });
        if (save) {
          try { localStorage.setItem('merci-theme', theme); } catch {}
        }
      };
      themeButtons.forEach((button) => button.addEventListener('click', () => setTheme(button.dataset.setTheme)));
      setTheme(document.documentElement.dataset.theme || 'midnight', false);

      const initTestimonialCarousel = () => {
        const viewport = document.querySelector('.quotes');
        const reviewTrack = viewport?.querySelector('.review-track');
        const originalSet = reviewTrack?.querySelector('.review-set');
        const summary = document.querySelector('.testimonial-summary');
        const carousel = viewport?.closest('.testimonials');
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

        if (!viewport || !reviewTrack || !originalSet || !summary || !carousel || viewport.dataset.carouselEnhanced === 'true' || reducedMotion.matches) return;

        const duplicateSet = originalSet.cloneNode(true);
        duplicateSet.setAttribute('aria-hidden', 'true');
        duplicateSet.removeAttribute('id');
        duplicateSet.querySelectorAll('[id]').forEach((element) => element.removeAttribute('id'));
        duplicateSet.querySelectorAll('a, button, input, select, textarea, [tabindex]').forEach((element) => element.setAttribute('tabindex', '-1'));
        reviewTrack.append(duplicateSet);

        const toggle = document.createElement('button');
        toggle.className = 'carousel-toggle';
        toggle.type = 'button';
        summary.append(toggle);

        let paused = false;
        let animationFrame = 0;
        let lastFrameTime = 0;
        let cycleWidth = 0;
        let position = viewport.scrollLeft;

        const updateToggle = () => {
          toggle.textContent = paused ? 'Resume' : 'Pause';
          toggle.setAttribute('aria-label', paused ? 'Resume testimonial carousel' : 'Pause testimonial carousel');
          carousel.dataset.carouselPaused = String(paused);
        };

        const stopAnimation = () => {
          if (animationFrame) window.cancelAnimationFrame(animationFrame);
          animationFrame = 0;
          lastFrameTime = 0;
        };

        const pause = (manual = false) => {
          paused = true;
          position = viewport.scrollLeft;
          stopAnimation();
          if (manual) viewport.dataset.manual = 'true';
          updateToggle();
        };

        const animate = (time) => {
          if (paused || !viewport.isConnected) {
            stopAnimation();
            return;
          }

          if (lastFrameTime) {
            const elapsed = Math.min(time - lastFrameTime, 50);
            position += elapsed * 0.012;
            if (position >= cycleWidth) position -= cycleWidth;
            viewport.scrollLeft = position;
          }
          lastFrameTime = time;
          animationFrame = window.requestAnimationFrame(animate);
        };

        const resume = () => {
          if (reducedMotion.matches) return;
          paused = false;
          position = viewport.scrollLeft;
          viewport.removeAttribute('data-manual');
          updateToggle();
          if (!animationFrame) animationFrame = window.requestAnimationFrame(animate);
        };

        const setInteracting = (interacting) => {
          carousel.dataset.carouselInteracting = String(interacting);
        };

        const measureCycle = () => {
          const trackStyle = window.getComputedStyle(reviewTrack);
          const gap = Number.parseFloat(trackStyle.gap) || 0;
          cycleWidth = originalSet.getBoundingClientRect().width + gap;
        };

        toggle.addEventListener('click', () => paused ? resume() : pause());
        viewport.addEventListener('pointerenter', () => setInteracting(true));
        viewport.addEventListener('pointerleave', () => { carousel.dataset.carouselInteracting = 'false'; });
        carousel.addEventListener('focusin', () => setInteracting(true));
        carousel.addEventListener('focusout', (event) => {
          if (!carousel.contains(event.relatedTarget)) carousel.dataset.carouselInteracting = 'false';
        });
        viewport.addEventListener('click', (event) => {
          if (event.target.closest('.carousel-toggle')) return;
          pause(true);
        });
        viewport.addEventListener('scroll', () => {
          if (paused) position = viewport.scrollLeft;
        }, { passive: true });
        const handleReducedMotionChange = (event) => {
          if (event.matches) pause(true);
        };
        reducedMotion.addEventListener('change', handleReducedMotionChange);
        window.addEventListener('resize', measureCycle);

        carousel.classList.add('carousel-enhanced');
        viewport.dataset.carouselEnhanced = 'true';
        measureCycle();
        updateToggle();
        animationFrame = window.requestAnimationFrame(animate);
        document.addEventListener('astro:before-swap', () => {
          stopAnimation();
          window.removeEventListener('resize', measureCycle);
          reducedMotion.removeEventListener('change', handleReducedMotionChange);
        }, { once: true });
      };

      initTestimonialCarousel();
      document.addEventListener('astro:page-load', initTestimonialCarousel);

      let revealObserver;
      const initScrollReveals = () => {
        revealObserver?.disconnect();
        if (!('IntersectionObserver' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.documentElement.classList.remove('has-reveal');
          return;
        }

        const revealTargets = document.querySelectorAll('[data-reveal]:not(.is-visible)');
        if (!revealTargets.length) return;

        revealObserver = new IntersectionObserver((entries, observer) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -32px 0px' });

        document.documentElement.classList.add('has-reveal');
        revealTargets.forEach((target) => revealObserver.observe(target));
      };

      initScrollReveals();
      document.addEventListener('astro:page-load', initScrollReveals);
    </script>
  </body>
</html>
